# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/ai_project_mentor

# PostgreSQL Connection String
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/ai_project_mentor

# JWT Authentication Secret & Expiration
JWT_SECRET=super_secret_jwt_key_change_in_production_32char
JWT_EXPIRES_IN=7d

# LLM API Key (Backend Only - NEVER expose to frontend)
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
